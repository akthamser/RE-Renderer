#version 430
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Output Texture (Binding 0)
layout(rgba32f, binding = 0) uniform image2D imgOutput;

// ----------------------------------------------------------------------------
// DATA STRUCTURES
// ----------------------------------------------------------------------------

struct GPUTriangle {
    vec3 v0; float _pad1;
    vec3 v1; float _pad2;
    vec3 v2; uint  matID; 
};

struct GPUMaterial {
    vec3 BaseColor;
    float Roughness; 
    float Metallic;
    float _pad1; 
    float _pad2;
    float _pad3; 
};

struct Light {
    int type;            // 0 = Directional, 1 = Point, 2 = Spot
    vec3 position;       
    vec3 direction;      
    vec3 color;          
    float intensity;     
    float range;         
    float innerCutoff;   
    float outerCutoff;   
};

struct Ray {
    vec3 origin;
    vec3 dir;
};

struct HitInfo {
    bool didHit;
    float dst;
    vec3 hitPoint;
    vec3 normal;
    uint matIndex;
};


struct BVHNode {
    vec3 bmin;
    int leftChild; // or FirstTriIndex if negative
    vec3 bmax;
    int triCount;
};

layout(std430, binding = 5) buffer BVHBuffer { BVHNode nodes[]; };
layout(std430, binding = 6) buffer IndexBuffer { int triIndices[]; }; // The sorted indices

// ----------------------------------------------------------------------------
// BUFFERS & UNIFORMS
// ----------------------------------------------------------------------------

// SSBOs (Scene Data)
layout(std430, binding = 2) buffer TriBuffer { GPUTriangle triangles[]; };
layout(std430, binding = 3) buffer MatBuffer { GPUMaterial materials[]; };
layout(std430, binding = 4) buffer NormalBuffer { vec4 normals[]; };

// Uniforms (Camera & Scene)
uniform int u_TriangleCount;
uniform int u_MaterialCount;
uniform vec3 u_CamPos;
uniform vec3 u_CamDir;
uniform vec3 u_CamRight;
uniform vec3 u_CamUp;
uniform float u_Fov_Scale;

// Uniforms (Lighting)
#define MAX_LIGHTS 16
uniform Light lights[MAX_LIGHTS];
uniform int lightCount;

layout(binding = 1) uniform samplerCube u_Skybox;

const float PI = 3.14159265359;
const float INFINITY = 1.0 / 0.0;

// ----------------------------------------------------------------------------
// 3. PBR MATH FUNCTIONS
// ----------------------------------------------------------------------------

vec3 GetSkyColor(vec3 rayDir) {
    vec3 color = texture(u_Skybox, rayDir).rgb;
    
    // Convert sRGB (PNG) to Linear Space
    return pow(color, vec3(2.2)); 
}
float DistributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float num = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;
    return num / denom;
}

float GeometrySchlickGGX(float NdotV, float roughness) {
    float r = (roughness + 1.0);
    float k = (r * r) / 8.0;
    float num = NdotV;
    float denom = NdotV * (1.0 - k) + k;
    return num / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    float ggx2 = GeometrySchlickGGX(NdotV, roughness);
    float ggx1 = GeometrySchlickGGX(NdotL, roughness);
    return ggx1 * ggx2;
}

vec3 FresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 PBR_Direct_Light(vec3 N, vec3 V, vec3 L, vec3 radiance, vec3 albedo, float roughness, float metallic) {
    roughness = max(roughness, 0.05); // Prevent divide by zero artifacts
    vec3 H = normalize(V + L); 
    
    vec3 F0 = vec3(0.04); 
    F0 = mix(F0, albedo, metallic);

    float NDF = DistributionGGX(N, H, roughness);   
    float G   = GeometrySmith(N, V, L, roughness);      
    vec3 F    = FresnelSchlick(max(dot(H, V), 0.0), F0);
        
    vec3 numerator    = NDF * G * F; 
    float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001;
    vec3 specular     = numerator / denominator;
    
    vec3 kS = F;
    vec3 kD = vec3(1.0) - kS;
    kD *= 1.0 - metallic;      

    float NdotL = max(dot(N, L), 0.0);        
    return (kD * albedo / PI + specular) * radiance * NdotL;
}

// ----------------------------------------------------------------------------
// 4. RAY TRACING LOGIC (INTERSECTION)
// ----------------------------------------------------------------------------

// Möller–Trumbore Intersection Algorithm
bool HitTriangle(Ray r, uint triIndex, out float t, out vec3 smoothNormal) {
    GPUTriangle tri = triangles[triIndex];

    vec3 edge1 = tri.v1 - tri.v0;
    vec3 edge2 = tri.v2 - tri.v0;
    vec3 h = cross(r.dir, edge1);
    float a = dot(edge2, h);

    if (a > -0.0001 && a < 0.0001) return false; // Parallel

    float f = 1.0 / a;
    vec3 s = r.origin - tri.v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, edge2);
    float v = f * dot(r.dir, q);
    if (v < 0.0 || u + v > 1.0) return false;

    t = f * dot(edge1, q);

    if (t > 0.001) { 
        // 1. Barycentric weighting for normal interpolation
        float w = 1.0 - u - v;

        // 2. Fetch Normals (Buffer is vec4, access .xyz)
        vec3 n0 = normals[triIndex * 3 + 0].xyz;
        vec3 n1 = normals[triIndex * 3 + 1].xyz;
        vec3 n2 = normals[triIndex * 3 + 2].xyz;

        // 3. Interpolate Normal
        smoothNormal = normalize(n0 * w + n1 * v + n2 * u);
        return true;
    }
    return false;
}


// Function: Intersect AABB
float HitAABB(Ray r, vec3 bmin, vec3 bmax) {
    vec3 invDir = 1.0 / r.dir;
    vec3 t0s = (bmin - r.origin) * invDir;
    vec3 t1s = (bmax - r.origin) * invDir;
    
    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger  = max(t0s, t1s);
    
    float tmin = max(tsmaller.x, max(tsmaller.y, tsmaller.z));
    float tmax = min(tbigger.x, min(tbigger.y, tbigger.z));
    
    return (tmin <= tmax && tmax > 0.0) ? tmin : 1e30;
}

// Replaces your old Trace() function
HitInfo TraceBVH(Ray ray) {
    HitInfo bestHit;
    bestHit.dst = 1e30;
    bestHit.didHit = false;

    // Stack for traversal (Depth 32 is enough for huge scenes)
    int stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = 0; // Push Root Node (Index 0)

    while (stackPtr > 0) {
        // Pop Node
        int nodeIdx = stack[--stackPtr];
        BVHNode node = nodes[nodeIdx];

        // 1. Check Box Intersection
        if (HitAABB(ray, node.bmin, node.bmax) < bestHit.dst) {
            
            // 2. Is Leaf? (triCount > 0)
            if (node.triCount > 0) {
                // Loop through triangles in this leaf
                int firstTriIdx = -node.leftChild; // We stored it negative!
                
                for (int i = 0; i < node.triCount; i++) {
                    int finalIdx = triIndices[firstTriIdx + i]; // Indirect lookup
                    
                    // Check Triangle
                    float t; vec3 n;
                    if (HitTriangle(ray, finalIdx, t, n)) {
                         if (t < bestHit.dst) {
                             bestHit.dst = t;
                             bestHit.didHit = true;
                             bestHit.normal = n;
                             bestHit.hitPoint = ray.origin + ray.dir * t;
                             bestHit.matIndex = triangles[finalIdx].matID;
                         }
                    }
                }
            } 
            else {
                // 3. Is Branch? Push Children
                // Optimization: Push the closer child last (so it's popped first)
                // For now, just push both.
                stack[stackPtr++] = node.leftChild;      // Left
                stack[stackPtr++] = node.leftChild + 1;  // Right (Simple builders usually put Right right after Left)
            }
        }
    }
    return bestHit;
}

// Shadow Trace (Any Hit = Blocked)
bool IsInShadow(vec3 origin, vec3 dir, float maxDist) {
    Ray shadowRay;
    shadowRay.origin = origin;
    shadowRay.dir = dir;

    for (int i = 0; i < u_TriangleCount; i++) {
        float t;
        vec3 n;
        if (HitTriangle(shadowRay, i, t, n)) {
            if (t < maxDist) return true; // Blocked!
        }
    }
    return false;
}

// ----------------------------------------------------------------------------
// 5. LIGHTING CALCULATION
// ----------------------------------------------------------------------------

vec3 CalculateLighting(vec3 pos, vec3 N, vec3 V, GPUMaterial mat) {
    vec3 Lo = vec3(0.0);
    
    // Iterate through all dynamic lights
    for(int i = 0; i < lightCount; ++i) {
        Light light = lights[i];
        
        vec3 L;
        float attenuation = 1.0;
        float distToLight = INFINITY;

        // --- A. Setup Light Vectors ---
        if (light.type == 0) { // Directional (Sun)
            L = normalize(-light.direction);
            distToLight = INFINITY; 
        } 
        else { // Point (1) or Spot (2)
            vec3 lightVec = light.position - pos;
            distToLight = length(lightVec);
            L = normalize(lightVec);
        }

        // --- B. Shadow Ray ---
        // Offset origin slightly (0.01) to prevent acne
        if (IsInShadow(pos + N * 0.01, L, distToLight)) {
            continue; // Light is blocked
        }

        // --- C. Attenuation ---
        if (light.type != 0) { 
            float att = 1.0 / (distToLight * distToLight + 1.0);
            float lightRadius = light.range;
            float distSqr = distToLight * distToLight;
            float radiusSqr = lightRadius * lightRadius;
            float factor = distSqr / radiusSqr;
            float smoothFactor = max(0.0, 1.0 - factor * factor);
            smoothFactor = smoothFactor * smoothFactor;
            attenuation = att * smoothFactor;
        }

        // --- D. Spotlight Cone ---
        if (light.type == 2) { 
            float theta = dot(L, normalize(-light.direction));
            float epsilon = light.innerCutoff - light.outerCutoff;
            float intensity = clamp((theta - light.outerCutoff) / epsilon, 0.0, 1.0);
            attenuation *= intensity;
        }

        // --- E. PBR Contribution ---
        if (attenuation > 0.0) {
            vec3 radiance = light.color * light.intensity * attenuation;
            Lo += PBR_Direct_Light(N, V, L, radiance, mat.BaseColor, mat.Roughness, mat.Metallic);
        }
    }

    // --- F. Ambient / IBL (Simple approximation) ---
    vec3 R = reflect(-V, N);
    vec3 envColor = GetSkyColor(R);
    
    vec3 F0 = mix(vec3(0.04), mat.BaseColor, mat.Metallic);
    vec3 F = FresnelSchlick(max(dot(N, V), 0.0), F0);
    
    float specularStrength = mix(1.0, 0.0, mat.Roughness); 
    vec3 envSpecular = envColor * F * specularStrength;
    vec3 ambientDiffuse = mat.BaseColor * 0.03 * (1.0 - mat.Metallic); 
    
    return Lo + envSpecular + ambientDiffuse;
}

// ----------------------------------------------------------------------------
// 6. MAIN
// ----------------------------------------------------------------------------

void main() {
ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screen_size = imageSize(imgOutput);

    if (pixel_coords.x >= screen_size.x || pixel_coords.y >= screen_size.y) return;

    // 1. Calculate UV (-1 to 1)
    vec2 uv = (vec2(pixel_coords) + 0.5) / vec2(screen_size);
    uv = uv * 2.0 - 1.0;

    // 2. APPLY ASPECT RATIO (The Missing Link)
    // We stretch the X coordinate to match the screen width
    float aspectRatio = float(screen_size.x) / float(screen_size.y);
    uv.x *= aspectRatio; 

    // 3. Generate Ray
    // u_CamRight handles the width, u_CamUp handles the height
    vec3 rayTarget = u_CamDir + (u_CamRight * uv.x * u_Fov_Scale) + (u_CamUp * uv.y * u_Fov_Scale);
    vec3 rayDir = normalize(rayTarget);
    Ray ray = Ray(u_CamPos, rayDir);

    // B. Trace Scene
    HitInfo hit = TraceBVH(ray);

    vec3 finalColor = vec3(0.0);
    
    if (hit.didHit) {
        // C. Fetch Material
        GPUMaterial mat = materials[hit.matIndex];
        
        // D. Calculate Lighting
        vec3 viewDir = normalize(u_CamPos - hit.hitPoint);
        finalColor = CalculateLighting(hit.hitPoint, hit.normal, viewDir, mat);


    }
    else {
        // Skybox
        finalColor = GetSkyColor(ray.dir);
    }

    imageStore(imgOutput, pixel_coords, vec4(finalColor, 1.0));
}